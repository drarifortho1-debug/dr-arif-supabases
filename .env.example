# ---------------------------------------------------------------------------
# Supabase
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose this to the browser and never commit it.
# Used for user management (creating staff accounts) in the admin panel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical URL, used for metadata and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which language the site opens in: bn or en
NEXT_PUBLIC_DEFAULT_LOCALE=bn
